# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# LinkedIn OAuth access token (scope: w_member_social, r_liteprofile)
# Get this from LinkedIn Developer Portal -> OAuth 2.0 tools -> Generate token
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here

# Your LinkedIn Person URN (optional - auto-fetched if not set)
# Format: urn:li:person:XXXXXXXXXX
# Find it: GET https://api.linkedin.com/v2/me -> id field
LINKEDIN_PERSON_URN=urn:li:person:YOUR_PERSON_ID

# Database path (optional, defaults to posts.db in project root)
# DB_PATH=posts.db
